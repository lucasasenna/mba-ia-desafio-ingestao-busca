# Provedor usado para embeddings e LLM: "gemini" ou "openai"
LLM_PROVIDER=gemini

# --- Gemini (https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
# Modelo de embeddings (3072 dimensões)
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
# LLM usada para responder (temperatura 0)
GOOGLE_LLM_MODEL=gemini-3.1-flash-lite

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
# Modelo de embeddings (1536 dimensões)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LLM usada para responder (temperatura 0)
OPENAI_LLM_MODEL=gpt-6-luna

# Conexão com o Postgres do docker-compose.yml (driver psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag

# Nome da collection no pgVector. Trocar o modelo de embeddings exige
# apagar esta collection (ou o volume) e reingerir.
PG_VECTOR_COLLECTION_NAME=document_pdf

# Caminho do PDF (relativo à raiz do projeto ou absoluto)
PDF_PATH=document.pdf
